[
  {
    "name": "AI智能题库",
    "homepage": "http://<YOUR_HOST>:5999/",
    "url": "http://<YOUR_HOST>:5999/api/search?api_key=<YOUR_API_KEY>",
    "method": "post",
    "type": "GM_xmlhttpRequest",
    "contentType": "json",
    "data": {
      "title": "${title}",
      "type": "${type}",
      "options": "${options}"
    },
    "handler": "return (res)=> res.code === 1 && res.answer ? [res.question, res.answer] : undefined"
  }
]
