# OpenAI API配置
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1  # 可选，默认为官方API地址

# 服务设置
HOST=0.0.0.0
PORT=5000
DEBUG=True

# 模型设置
OPENAI_MODEL=gpt-3.5-turbo
# 可选模型: gpt-3.5-turbo, gpt-4, gpt-4-turbo (根据API访问情况调整)

# 图片题（OCS 图片题优化）使用的多模态模型，不设置则沿用 OPENAI_MODEL
# VISION_MODEL=gpt-4o-mini
# 单题最多发送的图片数量
# MAX_IMAGES=10

# 安全设置 (对外部署强烈建议开启)
# API Key，多个用英文逗号分隔；OCS 配置 headers 中带上 X-API-Key
# API_KEYS=sk-ocs-change-me
# ACCESS_TOKEN=your_access_token_here  # 旧配置名，仍兼容